<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Tachiyomi" parent="Theme.Material3.Light.NoActionBar">
        <!-- Disallow "Force dark theme" -->
        <item name="android:forceDarkAllowed" tools:targetApi="Q">false</item>

        <!-- Theme Colors -->
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#000000</item>
        <item name="colorPrimaryInverse">#000000</item>
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFFFFF</item>
        <item name="colorOnSecondaryContainer">#000000</item>
        <item name="colorTertiary">#000000</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFFFFF</item>
        <item name="colorOnTertiaryContainer">#000000</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorSurfaceVariant">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#000000</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
        <item name="colorSurfaceInverse">#FFFFFF</item>
        <item name="colorOnSurfaceInverse">#000000</item>
        <item name="colorError">#000000</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFFFFF</item>
        <item name="colorOnErrorContainer">#000000</item>
        <item name="colorOutline">#000000</item>
        <item name="colorOutlineVariant">#000000</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorSurfaceContainerHighest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>

        <item name="android:divider">#000000</item>
        <item name="android:listDivider">@drawable/line_divider</item>
        <item name="materialDividerStyle">@style/Widget.Tachiyomi.MaterialDivider</item>

        <!-- Ripples -->
        <item name="colorControlHighlight">@android:color/transparent</item>

        <!-- Handles RTL Text -->
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>

        <!-- Themes -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="o_mr1">@null</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="Q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="Q">false</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Widget.Menu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Tachiyomi.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tachiyomi.MaterialAlertDialog</item>
        <item name="textAppearanceButton">@style/TextAppearance.Widget.Button</item>
        <item name="android:buttonStyle">?attr/borderlessButtonStyle</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionOverflowButtonStyle">@style/Theme.Tachiyomi.ActionButton.Overflow</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="appBarLayoutStyle">@style/Widget.Material3.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar.Surface</item>
        <item name="switchStyle">@style/Widget.Tachiyomi.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Elevated</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Tachiyomi" parent="Base.Theme.Tachiyomi" />
    <style name="Theme.Tachiyomi.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mihon_splash</item>
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.Tachiyomi</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
